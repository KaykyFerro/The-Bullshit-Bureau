---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedPosts } from '../../lib/articles';
---
<BaseLayout title="Buscar publicações" description="Pesquise notícias, artigos e editoriais do The Bullshit Bureau.">
  <header class="listing-header">
    <p class="section-kicker">Arquivo do jornal</p>
    <h1 class="section-title">Busca</h1>
    <p class="listing-description">Encontre publicações por título, resumo, categoria ou autoria.</p>
  </header>
  <form class="search-form" role="search" id="search-form">
    <label class="skip-link" for="search-input">Buscar no jornal</label>
    <input id="search-input" type="search" placeholder="Digite uma palavra ou assunto..." autocomplete="off" />
    <button type="submit">Pesquisar</button>
  </form>
  <p id="search-status" class="search-status" aria-live="polite">{publishedPosts.length} publicações no arquivo.</p>
  <div class="news-grid" id="search-results">
    {publishedPosts.map((post) => (
      <div class="search-result" data-search={`${post.frontmatter.title} ${post.frontmatter.excerpt} ${post.frontmatter.category} ${post.frontmatter.author}`.toLocaleLowerCase('pt-BR')}>
        <ArticleCard post={post} />
      </div>
    ))}
  </div>
  <script>
    const form = document.querySelector<HTMLFormElement>('#search-form');
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('#search-status');
    const results = [...document.querySelectorAll<HTMLElement>('.search-result')];

    function filterResults() {
      const query = input?.value.trim().toLocaleLowerCase('pt-BR') || '';
      let visible = 0;
      for (const result of results) {
        const matches = !query || (result.dataset.search || '').includes(query);
        result.hidden = !matches;
        if (matches) visible += 1;
      }
      if (status) {
        status.textContent = query
          ? `${visible} resultado(s) para “${input?.value.trim()}”.`
          : `${visible} publicações no arquivo.`;
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      filterResults();
    });
    input?.addEventListener('input', filterResults);
  </script>
</BaseLayout>
