---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedPosts } from '../../lib/articles';

const posts = publishedPosts.filter((post) => post.frontmatter.section === 'noticias');
---
<BaseLayout title="Notícias" description="Notícias publicadas pelo The Bullshit Bureau.">
  <header class="listing-header">
    <p class="section-kicker">A cobertura</p>
    <h1 class="section-title">Notícias</h1>
    <p class="listing-description">Fatos apurados, contexto e informação identificada com clareza.</p>
  </header>
  {posts.length ? <div class="news-grid">{posts.map((post) => <ArticleCard post={post} />)}</div> : <p class="empty-state">Ainda não há notícias publicadas nesta editoria.</p>}
</BaseLayout>
