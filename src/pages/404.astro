---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Página não encontrada" description="A página que você procura não foi encontrada." noindex={true}>
  <section class="admin-panel">
    <p class="section-kicker">Edição não localizada</p>
    <h1 class="section-title">Esta página não está nesta edição.</h1>
    <p>O endereço pode ter mudado ou a publicação pode ter sido retirada do ar.</p>
    <a class="button-link" href={base}>Voltar à primeira página</a>
  </section>
</BaseLayout>
