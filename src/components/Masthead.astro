---
const now = new Date();
const base = import.meta.env.BASE_URL;
const dateLabel = new Intl.DateTimeFormat('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(now);
---
<header class="page-shell">
  <div class="topline">
    <p>Edição digital independente</p>
    <p class="topline-right">Fatos • Contexto • Responsabilidade</p>
  </div>
  <div class="masthead">
    <p class="masthead-kicker">Jornal independente · Est. 2026</p>
    <a class="masthead-title" href={base} aria-label="The Bullshit Bureau, página inicial">
      THE <span>BULLSHIT BUREAU</span>
    </a>
    <p class="masthead-tagline">A verdade acima da ideologia.</p>
    <p class="masthead-note">{dateLabel}</p>
  </div>
  <nav class="main-nav" aria-label="Navegação principal">
    <a href={base}>Início</a>
    <a href={`${base}noticias/`}>Notícias</a>
    <a href={`${base}artigos/`}>Artigos</a>
    <a href={`${base}editoriais/`}>Editorial</a>
    <a href={`${base}opiniao/`}>Opinião</a>
    <a href={`${base}busca/`}>Busca</a>
    <a href={`${base}sobre/`}>Sobre</a>
    <a class="admin-link" href={`${base}admin/`}>Edição</a>
  </nav>
</header>
