{
  "name": "the-bullshit-bureau-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo Android e iOS do The Bullshit Bureau com Capacitor.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "build": "npm run sync:content && vite build",
    "dev": "vite --host 0.0.0.0",
    "cap:sync": "npm run build && cap sync",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "vite": "8.3.5"
  }
}
